NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://cefr:cefr@localhost:5432/cefr_uz?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Google accounts that become ADMIN on sign-in (comma-separated)
ADMIN_EMAILS=you@gmail.com

# Optional: enables AI feedback for Writing/Speaking (falls back to rule-based feedback if empty)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
